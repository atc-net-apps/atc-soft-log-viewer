<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="https://api.nuget.org/v3/index.json" value="https://api.nuget.org/v3/index.json" />
    <!--
      Temporary until Atc.LogCollector and Atc.LogAnalyzer are on nuget.org (atc-logviewer LOG-5).
      Fill it with build/pack-local-libraries.ps1. Remove this source and its mapping after the first release.
    -->
    <add key="local-libraries" value="local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="https://api.nuget.org/v3/index.json">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-libraries">
      <package pattern="Atc.LogCollector" />
      <package pattern="Atc.LogAnalyzer" />
    </packageSource>
  </packageSourceMapping>
</configuration>
