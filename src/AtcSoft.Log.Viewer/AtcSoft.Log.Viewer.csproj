<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app core: logic, settings and files without any UI technology, so every UI head can share it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="4.0.0" />
  </ItemGroup>

  <!-- See "Log libraries" in Directory.Build.props -->
  <ItemGroup Condition="'$(UseLogLibraryProjects)' == 'true'">
    <ProjectReference Include="$(LogLibrariesRoot)src\Atc.LogCollector\Atc.LogCollector.csproj" AdditionalProperties="ShouldUnsetParentConfigurationAndPlatform=false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLogLibraryProjects)' != 'true'">
    <PackageReference Include="Atc.LogCollector" Version="$(LogLibrariesVersion)" />
  </ItemGroup>

</Project>