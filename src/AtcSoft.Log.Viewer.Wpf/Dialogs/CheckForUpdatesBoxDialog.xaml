<atcDialogs:NiceDialogBox
    x:Class="AtcSoft.Log.Viewer.Wpf.Dialogs.CheckForUpdatesBoxDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcDialogs="clr-namespace:Atc.Wpf.Theming.Themes.Dialogs;assembly=Atc.Wpf.Theming"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Check for updates"
    Width="380"
    Height="240"
    Background="{DynamicResource AtcApps.Brushes.Dialog.Background}"
    ShowCloseButton="False"
    ShowMaxRestoreButton="False"
    ShowMinButton="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <DockPanel>

        <Border
            Height="50"
            Background="{DynamicResource AtcApps.Brushes.ThemeBackground1}"
            BorderBrush="{DynamicResource AtcApps.Brushes.Accent}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <atc:UniformSpacingPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="20">
                <Button
                    x:Name="DownloadButton"
                    Width="120"
                    Height="30"
                    Background="{DynamicResource AtcApps.Brushes.ThemeBackground}"
                    Click="OnDownload"
                    Content="Download latest"
                    Foreground="{DynamicResource AtcApps.Brushes.Text}"
                    IsEnabled="False" />
                <Button
                    Width="100"
                    Height="30"
                    Background="{DynamicResource AtcApps.Brushes.ThemeBackground}"
                    Click="OnClose"
                    Content="Close"
                    Foreground="{DynamicResource AtcApps.Brushes.Text}"
                    IsCancel="True"
                    IsDefault="True" />
            </atc:UniformSpacingPanel>
        </Border>

        <atc:UniformSpacingPanel
            Margin="20"
            Orientation="Vertical"
            Spacing="12">
            <TextBlock FontWeight="Bold" Text="AtcSoft Log Viewer" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Current version: " />
                <TextBlock x:Name="CurrentVersionTextBlock" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Latest version: " />
                <TextBlock x:Name="LatestVersionTextBlock" Text="-" />
            </StackPanel>
            <TextBlock
                x:Name="StatusTextBlock"
                Text="Checking for updates..."
                TextWrapping="Wrap" />
        </atc:UniformSpacingPanel>

    </DockPanel>

</atcDialogs:NiceDialogBox>